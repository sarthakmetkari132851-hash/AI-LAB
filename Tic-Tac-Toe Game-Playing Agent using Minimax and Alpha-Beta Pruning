Step 7: Play against the AI
python
def play_game():
    board = [' '] * 9

    print("You are O. The AI is X.")
    print("Choose positions using numbers 0 to 8.")

    while True:
        # AI move
        ai_move = best_move(board)

        if ai_move is None:
            print("Draw!")
            break

        board[ai_move] = 'X'
        print("\nAI chooses:", ai_move)
        show_board(board)

        if winner(board) == 'X':
            print("AI wins!")
            break

        if len(empty_boxes(board)) == 0:
            print("Draw!")
            break

        # Human move
        while True:
            try:
                player_move = int(input("Your move (0-8): "))

                if player_move in empty_boxes(board):
                    break

                print("That position is not available.")

            except ValueError:
                print("Please enter a number from 0 to 8.")

        board[player_move] = 'O'
        show_board(board)

        if winner(board) == 'O':
            print("You win!")
            break

        if len(empty_boxes(board)) == 0:
            print("Draw!")
            break


play_game()
Step 8: Quick recap
Minimax: Finds the best move by examining possible future game outcomes.

Alpha-Beta Pruning: Skips branches that cannot improve the final decision.

MAX (X): Tries to maximize the score.

MIN (O): Tries to minimize the score.

best_move(): Selects the AI's move.

play_game(): Lets you play against the AI.

Result: You have implemented a Tic-Tac-Toe AI that uses Minimax with Alpha-Beta Pruning to play optimally.
